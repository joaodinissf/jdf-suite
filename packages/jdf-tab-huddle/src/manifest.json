{
  "manifest_version": 3,
  "name": "Huddle",
  "short_name": "Huddle",
  "version": "0.8.0",
  "description": "Organize your browser tabs: sort, group, de-duplicate, snooze, and open links as tabs. Optional AI suggestions for groups.",
  "minimum_chrome_version": "147",
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "alarms",
    "notifications",
    "scripting",
    "activeTab",
    "favicon"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+U",
        "mac": "Alt+Shift+U"
      },
      "description": "Open the Huddle popup. Rebind at chrome://extensions/shortcuts"
    },
    "open-links": {
      "suggested_key": {
        "default": "Alt+Shift+L",
        "mac": "Alt+Shift+L",
        "chromeos": "Alt+Shift+K"
      },
      "description": "Open links on this page as tabs"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
